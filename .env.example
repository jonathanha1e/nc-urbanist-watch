# The dedicated inbox subscribed to all 99 councils' ENS agenda notifications
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_APP_PASSWORD=

# Only treat emails from this sender domain as ENS notifications
ENS_SENDER_FILTER=lacity.org

# Used only by scripts/subscribe.py, to sign up the inbox above with ENS
ENS_SUBSCRIBER_NAME=
ENS_SUBSCRIBER_EMAIL=

# true = print what would happen without doing it (subscribe.py, and any
# future send-side actions). Always test with true first.
DRY_RUN=true
